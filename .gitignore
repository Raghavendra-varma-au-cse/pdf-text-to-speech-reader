kokoro-v1.0.onnx
voices-v1.0.bin

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Python
__pycache__/
*.pyc
server/.venv/

# debug fixtures generated by scripts/generate-large-pdf.mjs
/debug/fixtures/*.pdf

# Android build output
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
