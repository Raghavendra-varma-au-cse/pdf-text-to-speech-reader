{
  "name": "pdf-text-to-speech-reader",
  "version": "1.0.0",
  "description": "A PDF reader with text-to-speech capabilities",
  "author": "Imran Pollob",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gh": "cross-env NEXT_PUBLIC_BASE_PATH=/pdf-text-to-speech-reader next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node tests/run.mjs",
    "debug:pdf": "node scripts/generate-large-pdf.mjs",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "android": "cap open android",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "dompurify": "^3.4.17",
    "idb-keyval": "^6.3.0",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "next": "16.3.5",
    "pdfjs-dist": "5.4.449",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.22",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
