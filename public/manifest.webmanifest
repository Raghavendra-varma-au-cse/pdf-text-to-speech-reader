{
  "name": "ReadAloud",
  "short_name": "ReadAloud",
  "description": "ReadAloud: free PDF & text to speech reader for PDF, DOCX, TXT and Markdown with synchronized sentence highlighting.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "categories": ["productivity", "education", "utilities"],
  "background_color": "#071311",
  "theme_color": "#0d9488",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
