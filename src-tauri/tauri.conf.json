{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadAloud",
  "version": "1.0.0",
  "identifier": "app.readaloud.reader",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReadAloud",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "PDF and text reader with synchronized text-to-speech",
    "longDescription": "ReadAloud reads PDF, DOCX, Markdown and plain-text documents aloud with synchronized sentence highlighting. Documents are parsed locally and the app works without a Kokoro server."
  }
}
